<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Banner wie im Web-Interface (webui.py, img.banner) - dasselbe Bild (pics/radiosabbelnich.webp). -->
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            android:src="@drawable/banner"
            android:contentDescription="@string/app_name"
            app:shapeAppearanceOverlay="@style/BannerShapeOverlay" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buildTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textSize="12sp"
            android:textColor="#888888" />

        <!-- STT-Sprachen (siehe stt/SttSettingsActivity.kt) -->
        <Button
            android:id="@+id/manageSttLanguagesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_manage_stt_languages" />

        <TextView
            android:id="@+id/sttModelMissingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#CC3333"
            android:visibility="gone" />

        <!--
            Laufende STT-Kalibrierung: die Session ueberlebt das Verlassen des
            Wizard-Bildschirms, und solange sie laeuft, ist das automatische
            Umschalten bewusst aus (siehe PlaybackService) - ohne diesen Hinweis
            sah das wie ein Defekt aus (Review-Befund 9, siehe SESSION.md).
        -->
        <TextView
            android:id="@+id/calibrationActiveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="#1ABC9C"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#DDDDDD" />

        <!-- Sender -->
        <LinearLayout
            android:id="@+id/stationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/manageStationsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_manage_stations" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#DDDDDD" />

        <!-- Status -->
        <TextView
            android:id="@+id/currentStationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_station_none"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_idle"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Fingerprint-Korrektur (siehe fingerprint/FingerprintDb.kt) - nur
             sichtbar, solange ein rueckgaengig machbarer Treffer vorliegt. -->
        <Button
            android:id="@+id/zappingErrorButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_zapping_error"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/zapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_zappen" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_stop" />
        </LinearLayout>

        <!-- Bullshitometer: Live-Balken fuer die rohe Sprache-Wahrscheinlichkeit
             (StreamAnalyzer.speechRatio), analog zum Web-Interface (webui.py). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bs_meter_label"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bsMeterPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bs_meter_off"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/bsMeterBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/bs_meter_track" />

        <!-- Fingerprint (siehe fingerprint/Fingerprint.kt, fingerprint/FingerprintDb.kt),
             analog zum Web-Interface-Chip. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fp_chip_label"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fingerprintChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fp_chip_off"
                android:textSize="14sp" />
        </LinearLayout>

        <!--
            Bis zum Phase-8-Review gab es ueberhaupt keine Moeglichkeit, die
            gelernten Clips loszuwerden (clearAll() war toter Code, siehe
            Review-Befund 16 in SESSION.md) - sinnvoll z.B. nach einer laengeren
            Fehlklassifikations-Serie oder beim Wechsel des Senderbestands.
        -->
        <Button
            android:id="@+id/clearFingerprintsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_clear_fingerprints" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#DDDDDD" />

        <!-- Nachrichten-Pause (siehe newsbreak/NewsBreak.kt, newsbreak/NewsBreakSettings.kt) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/news_break_label"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/newsBreakEnabledCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/news_break_enabled" />

        <Button
            android:id="@+id/newsBreakFolderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_news_break_folder" />

        <TextView
            android:id="@+id/newsBreakFolderStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:textSize="12sp"
            android:textColor="#888888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/newsBreakWindowMinutesInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="@string/news_break_window_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveNewsBreakWindowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_update_server" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#DDDDDD" />

        <!-- Update-Mechanismus (siehe UpdateManager.kt) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_server_label"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/updateServerUrlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textUri"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveUpdateServerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_update_server" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="12sp"
            android:textColor="#888888" />

        <Button
            android:id="@+id/updateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_check_update" />

    </LinearLayout>
</ScrollView>
