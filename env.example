ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change_me_admin
ICECAST_SOURCE_PASSWORD=change_me_source
ICECAST_HOSTNAME=dockfish.icefish-ghost.ts.net
ICECAST_PORT=8000
ICECAST_LOCATION=Hamburg
ICECAST_ADMIN_EMAIL=admin@example.com
WEBUI_PORT=5000
# Ordner mit MP3s für die Nachrichten-Pause (siehe README/news_break.py).
# Host-Pfad, z.B. ein SMB-Mount -- wird read-only in den Container gemountet.
# Optional: ohne SMB-Freigabe reicht der Default (./data/news_mp3), das
# Feature bleibt einfach deaktiviert/leer, bis Dateien reinkommen und man es
# unter /config bzw. per settings.json aktiviert.
NEWS_MP3_FOLDER=./data/news_mp3

# Ordner mit einem entpackten deutschen Vosk-Modell für den STT-
# Sprachfilter (siehe README/stt_filter.py). Host-Pfad, wird read-only
# gemountet. Optional: nur relevant, wenn stt_filter.enabled=true UND
# engine="vosk" in settings.json (bzw. per /config) gesetzt ist -- ohne
# Modell an diesem Pfad deaktiviert sich das Feature selbst (Log-Meldung,
# kein Absturz).
VOSK_MODEL_FOLDER=./data/vosk-model-de

# TLS-Zertifikat für HTTPS (Web-Interface auf WEBUI_PORT, zusätzlicher
# HTTPS-Port für den Icecast-Stream, siehe ICECAST_SSL_PORT). Host-Pfade
# zu PEM-Dateien, z.B. per `tailscale cert <hostname>` erzeugt. Optional:
# leer/nicht gesetzt lässt beide Dienste bei reinem HTTP wie bisher (siehe
# docker-compose.yml -- Default-Mount ist /dev/null, kein Absturz ohne
# Zertifikat). Für das Web-Interface zusätzlich "tls_enabled" in
# settings.json bzw. den Haken unter /config nötig; der Icecast-Port hier
# aktiviert sich automatisch, sobald beide Dateien vorhanden sind.
TLS_CERT_FILE=
TLS_KEY_FILE=
ICECAST_SSL_PORT=8443

# Startsprache des Web-Interfaces: "de" oder "en" (siehe i18n.py). Gilt nur
# für eine Neuinstallation ohne bestehende settings.json -- danach gewinnt
# immer die über /config gespeicherte Einstellung, auch nach Neustarts.
# Ungültige/leere Werte fallen still auf "de" zurück.
UI_LANGUAGE=de
