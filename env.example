ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=change_me_admin
ICECAST_SOURCE_PASSWORD=change_me_source
ICECAST_HOSTNAME=dockfish.icefish-ghost.ts.net
ICECAST_PORT=8000
ICECAST_LOCATION=Hamburg
ICECAST_ADMIN_EMAIL=admin@example.com
WEBUI_PORT=5000
# Ordner mit MP3s für die Nachrichten-Pause (siehe README/news_break.py).
# Host-Pfad, z.B. ein SMB-Mount -- wird read-only in den Container gemountet.
# Optional: ohne SMB-Freigabe reicht der Default (./data/news_mp3), das
# Feature bleibt einfach deaktiviert/leer, bis Dateien reinkommen und man es
# unter /config bzw. per settings.json aktiviert.
# Enthält der Pfad Sonderzeichen (Apostroph, Leerzeichen, #, ...): in
# doppelte Anführungszeichen setzen, z.B. NEWS_MP3_FOLDER="/mnt/x/80's/".
# KEIN Backslash zum Escapen -- anders als in einer Shell entfernt Docker
# Compose den nicht, er landet wörtlich im Pfad und der Mount schlägt fehl
# (./radiosabbelnich.sh check bzw. ./radiosabbelnich.sh start fangen das ab).
NEWS_MP3_FOLDER=./data/news_mp3

# Ordner mit MP3s für den Musiksammlung-Modus (siehe README/music_library.py).
# Host-Pfad, wird read-only in den Container gemountet -- gleiches Muster wie
# NEWS_MP3_FOLDER oben. Optional: ohne eigene Sammlung reicht der Default
# (./data/music_library), der Musiksammlung-Modus liefert dann einfach keine
# Tracks, bis Dateien reinkommen und der Root-Ordner unter /config per
# Breadcrumb-Auswahl gesetzt wird.
MUSIC_LIBRARY_FOLDER=./data/music_library

# Ordner mit einem entpackten deutschen Vosk-Modell für den STT-
# Sprachfilter (siehe README/stt_filter.py). Host-Pfad, wird read-only
# gemountet. Optional: nur relevant, wenn stt_filter.enabled=true UND
# engine="vosk" in settings.json (bzw. per /config) gesetzt ist -- ohne
# Modell an diesem Pfad deaktiviert sich das Feature selbst (Log-Meldung,
# kein Absturz).
VOSK_MODEL_FOLDER=./data/vosk-model-de

# Zusätzliches Vosk-Modell für Englisch (Mehrsprachigkeit, siehe README
# "Zusätzliche Vosk-Modelle mounten") -- gleiches Prinzip, ein weiterer
# Mount pro zusätzlicher Sprache.
VOSK_MODEL_FOLDER_EN=./data/vosk-model-en

# TLS-Zertifikat für HTTPS (Web-Interface auf WEBUI_PORT, zusätzlicher
# HTTPS-Port für den Icecast-Stream, siehe ICECAST_SSL_PORT). Host-Pfade
# zu PEM-Dateien, z.B. per `tailscale cert <hostname>` erzeugt. Optional:
# leer/nicht gesetzt lässt beide Dienste bei reinem HTTP wie bisher (siehe
# docker-compose.yml -- Default-Mount ist /dev/null, kein Absturz ohne
# Zertifikat). Für das Web-Interface zusätzlich "tls_enabled" in
# settings.json bzw. den Haken unter /config nötig; der Icecast-Port hier
# aktiviert sich automatisch, sobald beide Dateien vorhanden sind.
TLS_CERT_FILE=
TLS_KEY_FILE=
ICECAST_SSL_PORT=8443

# API-Token für AudD (https://audd.io, kostenloses Kontingent verfügbar) --
# aktiviert die Song-Erkennung Phase 2 (Cloud-Lookup bei Cache-Miss, siehe
# README/ARCHITECTURE.md, Abschnitt "Song-Erkennung"). Optional: leer lässt
# Phase 1 (nur lokaler Fingerprint-Cache, kein Titel/Interpret) unverändert
# laufen, kein Absturz. Zusätzlich zum Token muss
# song_recognition.cloud_lookup_enabled in settings.json (bzw. künftig per
# /config) auf true stehen -- ein gesetzter Token allein reicht bewusst
# nicht (Cloud-Lookups kosten Kontingent, siehe song_fingerprint.py).
AUDD_API_TOKEN=

# Startsprache des Web-Interfaces: "en" (im Code eingebettete Basissprache)
# oder der Code einer Sprachdatei unter language/*.lng (z.B. "de" für
# language/Deutsch.lng, siehe i18n.py). Gilt nur für eine Neuinstallation
# ohne bestehende settings.json -- danach gewinnt immer die über /config
# gespeicherte Einstellung, auch nach Neustarts. Ungültige/leere Werte oder
# eine nicht (mehr) vorhandene Sprachdatei fallen still auf "en" zurück.
UI_LANGUAGE=
