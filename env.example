WEBUI_PORT=5000
# Ordner mit MP3s für die Nachrichten-Pause (siehe README/news_break.py).
# Host-Pfad, z.B. ein SMB-Mount -- wird read-only in den Container gemountet.
# Optional: ohne SMB-Freigabe reicht der Default (./news_mp3), das Feature
# bleibt einfach deaktiviert/leer, bis Dateien reinkommen und man es unter
# /config bzw. per settings.json aktiviert.
NEWS_MP3_FOLDER=./news_mp3
