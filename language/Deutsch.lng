# ==== Config-Seite (/config) ====
cfg_back_link=← zurück zum Player
# --- ⚙ Sender verwalten ---
cfg_heading=⚙ Sender verwalten
# --- 📰 Nachrichten-Pause ---
cfg_news_break_heading=📰 Nachrichten-Pause
cfg_news_break_hint=Spielt zur vollen/halben Stunde statt eines Radiosenders eine zufällige lokale MP3 ab. Der Ordner unten liegt unter einem <strong>Container-internen Pfad</strong> — der eigentliche Host-Ordner (z.B. ein SMB-Mount) wird über <code>NEWS_MP3_FOLDER</code> in <code>.env</code> nach <code>/app/news_mp3</code> gemountet und braucht dafür einen Neustart des Containers. Darunter kannst du per Klick den gewünschten Unterordner auswählen.
cfg_active_label=aktiv
cfg_nb_folder_label=MP3-Ordner (Container-Pfad)
cfg_nb_window_label=Zeitfenster (Minuten)
cfg_nb_hours_enabled_label=nur zu bestimmten Stunden aktiv
cfg_nb_hour_start_label=von Stunde
cfg_nb_hour_end_label=bis Stunde
cfg_nb_adskip_enabled_label=Werbeblock nach der Pause überspringen (experimentell)
cfg_nb_adskip_hint=Verbindet sich in den letzten Sekunden der Pause-MP3 schon im Hintergrund mit dem Sender und hört auf Musik — wird sie rechtzeitig erkannt, steigt die Wiedergabe direkt in der Musik ein statt in einem live laufenden Werbeblock. Best-Effort: ein Live-Radiostream lässt sich nicht vorspulen, ein längerer Werbeblock läuft dann wie bisher live weiter.
cfg_nb_adskip_lead_label=Vorlaufzeit vor Pause-Ende (Sekunden)
cfg_nb_speechgate_hint=Startet die Pause nur noch, wenn zur Zeitfenster-Grenze ZUSÄTZLICH gerade Sprache auf dem Live-Sender erkannt wird — verhindert, dass rein zeitbasiert ausgelöst wird, während noch Musik läuft. Ohne erkannte Sprache verstreicht das Zeitfenster einfach, die Pause fällt für diesen Termin aus.
cfg_nb_speechgate_enabled_label=Pause nur bei erkannter Sprache starten (experimentell)
cfg_nb_speechgate_window_label=Toleranzfenster um :00/:30 (Minuten)
cfg_nb_speechgate_streak_label=Nötige Sprache-Fenster am Stück
# --- 🎵 Player ---
cfg_music_library_heading=🎵 Player
cfg_music_library_hint=Root-Ordner für den Player-Modus (Play/Stop auf der /musik-Seite) — Container-interner Pfad, gemountet über MUSIC_LIBRARY_FOLDER in .env.
cfg_music_library_folder_label=Musik-Ordner (Container-Pfad)
cfg_music_library_saved=🎵 Player-Einstellungen gespeichert.
# --- Neuer Sender ---
cfg_new_station_heading=Neuer Sender
cfg_add_name_placeholder=Name
cfg_add_url_placeholder=Stream-URL (https://...)
cfg_enabled_label=aktiviert
cfg_add_btn=Hinzufügen
# --- 📻 Sender-Import ---
cfg_import_heading=📻 Sender-Import
cfg_import_hint=Lädt eine M3U-Playlist und hört bei jedem Sender ein paar Sekunden mit: übernommen wird nur, wer dabei durchgehend Audio liefert (nicht bloß beim Verbinden). Neue Sender landen <strong>deaktiviert</strong> in der Kategorie "Unsortiert" — du entscheidest per Haken, wer in die Rotation darf. Kann bei einer langen Liste einige Minuten dauern.
cfg_import_url_label=Playlist-URL
cfg_import_btn=Sender importieren
# --- 🔗 Streaming-Adresse ---
cfg_stream_heading=🔗 Streaming-Adresse
cfg_stream_hint=Adresse, die auf der Startseite unter "Streaming via VLC" angezeigt wird (zum Eintragen in einen externen Player). Leer lassen, um sie automatisch aus der Adresse zu bilden, über die die Startseite gerade im Browser aufgerufen wird.
cfg_stream_url_label=Stream-URL
# --- 🔒 HTTPS ---
cfg_tls_heading=🔒 HTTPS
cfg_tls_hint=Verschlüsselt den Zugriff aufs Web-Interface (Player-Seite und diese Config-Seite) per TLS. Braucht ein Zertifikat unter <code>TLS_CERT_FILE</code>/<code>TLS_KEY_FILE</code> in <code>.env</code> (Host-Pfade zu PEM-Dateien, z.B. per <code>tailscale cert</code> erzeugt) — ohne die bleibt der Haken hier wirkungslos, das Web-Interface läuft dann weiter über HTTP. <strong>Wirkt erst nach einem Neustart des Containers</strong> (<code>docker compose up -d --build radiosabbelnich</code>), nicht sofort wie die meisten anderen Einstellungen hier. Der Icecast-Stream selbst bekommt unabhängig davon automatisch einen zusätzlichen HTTPS-Port, sobald dieselben Zertifikate in <code>.env</code> eingetragen sind — dafür gibt es keinen eigenen Schalter.
cfg_tls_checkbox_label=HTTPS fürs Web-Interface aktiv
# --- 🔄 Automatische Update-Prüfung ---
cfg_update_check_heading=🔄 Automatische Update-Prüfung
cfg_update_check_hint=Prüft alle 24h per reinem Lesezugriff gegen GitHub, ob der <code>main</code>-Branch weiter ist als diese Installation. Es gibt für die Docker-Installation aktuell KEIN Image-Registry-Deployment — die einzige Update-Möglichkeit ist <code>git pull</code> im Repo-Verzeichnis, danach <code>docker compose up -d --build radiosabbelnich</code>. Kein Auto-Update, keine automatische Installation — bei Verfügbarkeit erscheint nur ein Hinweis oben auf dieser Seite und der Player-Seite.
cfg_update_check_checkbox=Automatisch nach Updates suchen
update_banner_text=🔄 Update verfügbar ({version}) — im Repo-Verzeichnis git pull ausführen, danach neu bauen.
update_banner_changelog_link=Was ist neu?
# --- ⏱ Puffer-Einstellungen ---
cfg_buffer_heading=⏱ Puffer-Einstellungen
cfg_buffer_hint=Die nächsten Sender in Rotationsreihenfolge laufen im Hintergrund mit und halten Audio vor, damit Wechsel flüssig ablaufen. Mehr Sekunden/Sender = flüssiger, aber mehr Bandbreite/CPU.
cfg_buffer_seconds_label=Sekunden pro gepuffertem Sender
cfg_buffer_count_label=Anzahl vorausgepufferter Sender
# --- 🗣 STT-Sprachfilter ---
cfg_stt_heading=🗣 STT-Sprachfilter
cfg_stt_hint=Zusätzliches Signal per Speech-to-Text: erkennt, ob gerade zusammenhängender Text in der jeweils erwarteten Sprache zu hören ist (echte Moderation) oder nicht (auch in dieser Sprache gesungene Musik zählt dann als "keine Sprache") — ergänzt VAD/Heuristik, die reinen Gesang oft fälschlich als Sprache werten. <strong>Vosk</strong> ist leichtgewichtig und Pi-tauglich, <strong>Whisper</strong> genauer, aber deutlich ressourcenhungriger. Welche Sprache für welchen Sender gilt, wird unten über die Sender-Kategorie festgelegt.
cfg_stt_status_loading=Lade Status …
cfg_stt_engine_label=Engine
cfg_stt_engine_vosk_option=Vosk (leichtgewicht, Pi-tauglich)
cfg_stt_engine_whisper_option=Whisper (genauer, ressourcenhungriger)
cfg_stt_whisper_size_label=Whisper-Modellgröße
cfg_stt_interval_label=Sample-Intervall (Sekunden)
cfg_stt_combine_label=Verknüpfung mit VAD/Heuristik
cfg_stt_combine_and_option=UND — beide müssen "Sprache" sagen (empfohlen)
cfg_stt_combine_or_option=ODER — eines reicht
# --- 🌐 STT-Sprachen ---
cfg_stt_lang_heading=🌐 STT-Sprachen
cfg_stt_lang_hint=Pro Sprache ein Vosk-Modellpfad (nur bei Engine "Vosk" relevant, jede Sprache braucht ein eigenes Modell) und eine empirisch ermittelte Konfidenz-Schwelle (siehe README). Ein bereits vorhandener Sprachcode wird beim erneuten Eintragen aktualisiert statt doppelt angelegt.
cfg_stt_lang_col_code=Sprache
cfg_stt_lang_col_vosk_path=Vosk-Modellpfad
cfg_stt_lang_col_threshold=Schwelle
cfg_stt_lang_col_status=Status
cfg_stt_lang_code_placeholder=z.B. en
cfg_stt_lang_add_btn=+ Sprache hinzufügen/aktualisieren
cfg_stt_lang_status_unknown=noch nicht geladen
cfg_stt_lang_status_ok=✅ geladen
cfg_stt_lang_status_error=⚠ {error}
cfg_stt_lang_saved=Sprache gespeichert.
cfg_stt_lang_deleted=Sprache gelöscht.
cfg_stt_lang_delete_confirm=Sprache '{code}' wirklich löschen? Kategorien, die ihr zugeordnet sind, fallen danach auf Deutsch zurück.
# --- 🏷 Kategorie-Sprachen ---
cfg_stt_cat_lang_heading=🏷 Kategorie-Sprachen
cfg_stt_cat_lang_hint=Legt fest, welche der oben konfigurierten Sprachen für Sender welcher Kategorie geprüft wird. Kategorien ohne Auswahl gelten als Deutsch.
cfg_stt_cat_lang_default=(Standard: Deutsch)
cfg_stt_cat_lang_saved=Kategorie-Sprache gespeichert.
# --- 🧪 Schwellwert-Kalibrierung ---
cfg_stt_calib_heading=🧪 Schwellwert-Kalibrierung
cfg_stt_calib_hint=Ermittelt einen Vorschlag für <code>confidence_threshold</code> einer Sprache, nach derselben Methode wie die ursprüngliche Deutsch-Kalibrierung (siehe README): erst ein paar Minuten einen Sender mit garantiert echtem Sprachtext dieser Sprache mithören lassen, dann einen Musiksender derselben Sprache. Sender dafür manuell auf der <a href="/">Player-Seite</a> auswählen — die Kalibrierung selbst schaltet nichts um. Voraussetzung: STT-Filter und Sabbelfilter oben sind aktiv. Für Vosk muss die Sprache mit Modellpfad bereits in "🌐 STT-Sprachen" angelegt sein (bei Whisper nicht nötig).
cfg_stt_calib_start_btn=🧪 Kalibrierung starten
cfg_stt_calib_active_label=Kalibriere:
cfg_stt_calib_stage_speech_btn=🗣 Sprache-Stufe
cfg_stt_calib_stage_music_btn=🎵 Musik-Stufe
cfg_stt_calib_stop_btn=Abbrechen
cfg_stt_calib_col_speech=🗣 Sprache-Samples
cfg_stt_calib_col_music=🎵 Musik-Samples
cfg_stt_calib_no_samples=noch keine Samples
cfg_stt_calib_summary={count} Sample(s), Konfidenz min {min} / max {max} / Ø {mean}
cfg_stt_calib_suggestion_clean=✅ Vorschlag: {threshold} (Sprache und Musik trennen sauber im gemessenen Sample)
cfg_stt_calib_suggestion_warn=⚠ Vorschlag: {threshold} — Sprache und Musik überlappen sich im gemessenen Sample, kein sauberer Trennwert gefunden. Mehr Samples sammeln oder Sender prüfen.
cfg_stt_calib_apply_btn=Übernehmen
cfg_stt_calib_applied=Schwellwert übernommen.
cfg_stt_calib_samples_summary=Letzte Samples anzeigen
cfg_stt_calib_no_text=(kein Text erkannt)
cfg_stt_calib_lang_required=Sprachcode darf nicht leer sein.
# --- 🗑 Fingerprint-Datenbank ---
cfg_fingerprint_heading=🗑 Fingerprint-Datenbank
cfg_fingerprint_hint=Löscht alle gelernten Jingle-/Werbespot-Clips (nicht die Senderliste). Danach lernt die Erkennung wieder bei Null.
cfg_fingerprint_clear_btn=Clip-DB leeren
# --- 💾 Ressourcen-Verbrauch ---
cfg_resources_heading=💾 Ressourcen-Verbrauch
cfg_resources_hint=Aktueller Verbrauch von RadioSabbelNich selbst (nicht des Hosts), alle 5 Sekunden aktualisiert.
cfg_resources_ram_total=RAM gesamt
cfg_resources_ram_breakdown=davon Python / ffmpeg
cfg_resources_cpu_total=CPU gesamt
cfg_resources_ffmpeg_count=Laufende ffmpeg-Prozesse
cfg_resources_fingerprint_db=Fingerprint-DB
cfg_resources_log=Logdatei (inkl. Rotation)
cfg_resources_whisper_cache=Whisper-Modell-Cache
# --- 🌐 Sprache ---
cfg_language_heading=🌐 Sprache
cfg_language_hint=Sprache der Web-Oberfläche (Player- und Config-Seite). Wirkt sofort für neue Seitenaufrufe; diese Seite lädt nach dem Speichern automatisch neu. Startwert kommt aus <code>UI_LANGUAGE</code> in <code>.env</code>, danach gewinnt immer die hier gespeicherte Einstellung.
cfg_language_label=Sprache der Oberfläche

